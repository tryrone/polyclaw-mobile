{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_POLYCLAW_ACCESS_MODE": "PILOT",
        "EXPO_PUBLIC_POLYCLAW_WALLET_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6805225562"
      }
    }
  }
}
