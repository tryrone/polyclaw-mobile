{
  "expo": {
    "name": "PolyClaw",
    "slug": "polyclaw-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polyclaw",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.betclaw.polyclaw",
      "buildNumber": "23",
      "usesAppleSignIn": true,
      "icon": "./assets/images/ios-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "UTCB899C35"
    },
    "android": {
      "package": "com.betclaw.polyclaw",
      "adaptiveIcon": {
        "backgroundColor": "#08060F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PolyClaw to unlock using Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08060F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#08060F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
